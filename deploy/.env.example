# Copy to deploy/.env only on the authorized host. Never commit real values.
DATABASE_URL=postgres://USER:PASSWORD@MANAGED_HOST:5432/warehouse?sslmode=verify-full
DEMO_DOMAIN=warehouse.example.invalid
DEMO_USER=reviewer
# Generate interactively with caddy hash-password; retain single quotes for $.
DEMO_PASSWORD_HASH='REPLACE_WITH_BCRYPT_HASH'
# Empty disables Redis; use redis://redis:6379/0 with --profile cache.
REDIS_URL=
