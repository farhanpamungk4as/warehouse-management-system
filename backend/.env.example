# Host-mode configuration; this file is a template, not automatically loaded.
DATABASE_URL=postgres://warehouse:warehouse_local_only@localhost:5432/warehouse?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=info
DB_MAX_CONNS=10
STARTUP_TIMEOUT=10s
REQUEST_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
# Optional Compose overrides (root .env or exported environment):
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse_local_only
POSTGRES_DB=warehouse
API_PORT=18080

# Optional read-through location cache; empty disables caching
REDIS_URL=
REDIS_TTL=30s
